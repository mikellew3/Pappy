# Supabase project credentials.
# Copy this file to `.env.local` for local dev, and set the same two vars in
# Vercel → Project → Settings → Environment Variables for production.
#
# Find these in the Supabase dashboard: Project Settings → API.
#   - "Project URL"            -> VITE_SUPABASE_URL
#   - "anon" / "public" key    -> VITE_SUPABASE_ANON_KEY
#
# The anon key is safe to expose in the client; row-level security (RLS)
# enforces that each user only ever sees their own picks.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
